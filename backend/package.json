{
  "name": "employee-data-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Employee Data Management System",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "node src/utils/seed.js"
  },
  "keywords": ["employee", "crud", "api", "express", "sqlite"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.10.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/utils/seed.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}